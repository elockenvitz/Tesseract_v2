# dependencies
node_modules/

# build output
dist/

# env files (local secrets)
.env.local
.env*
!.env.example

# logs & OS junk
*.log
.DS_Store
Thumbs.db

# MCP configuration (contains sensitive tokens)
.mcp.json

*storybook.log
storybook-static

# Signal card gallery build + Playwright scratch. The screenshots under
# artifacts/cards/ are kept deliberately — they are the review artifact.
dist-gallery/
artifacts/playwright-output/

# The invitation e2e suite's build and scratch. Same reasoning as above: the
# build is the whole application, regenerated by `npm run guard:invite`.
dist-invite-e2e/
artifacts/playwright-invite-output/
test-results/

# Raw database dumps. A pg_dump of production describes the entire security
# model and must stay outside the repository — see
# docs/audit/baselines/README.md. Its sanitized counterpart, produced by
# scripts/audit/schema-baseline.mjs, is NOT version controlled either: it is
# still a complete map of the security surface. Both belong in
# %USERPROFILE%\.tesseract\schema-baselines\ — see the rule at the bottom of
# this file.
#
# Deliberately narrow: supabase/migrations/*.sql and supabase/tests/*.sql are
# tracked and must stay tracked, so this matches only the repo root, which is
# where `pg_dump -f prod-schema.sql` lands by default.
/*.sql
/*.dump
prod-schema*.sql
staging-schema*.sql
dist-visual/

# Generated security inventories.
#
# `scripts/audit/schema-baseline.mjs` writes one of these, and its default
# output path is docs/audit/baselines/production-security-inventory.json — a
# name that says "production" whatever project it was actually captured from.
# One generated from STAGING sat there under that name on 2026-08-28.
#
# A sanitized inventory is still a complete map of the security surface, and
# per docs/audit/baselines/README.md it is deliberately not carried on main.
# Keep captures in %USERPROFILE%\.tesseract\schema-baselines\, named for the
# project they came from.
docs/audit/baselines/*.json

# Desktop harness screenshots (regenerated by desktop-harness/measure.mjs)
.shots/
dist-desktop-harness/
