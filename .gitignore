# dependencies
node_modules/

# build output
dist/

# env files (local secrets)
.env.local
.env*
!.env.example

# logs & OS junk
*.log
.DS_Store
Thumbs.db

# MCP configuration (contains sensitive tokens)
.mcp.json

*storybook.log
storybook-static

# Signal card gallery build + Playwright scratch. The screenshots under
# artifacts/cards/ are kept deliberately — they are the review artifact.
dist-gallery/
artifacts/playwright-output/

# The invitation e2e suite's build and scratch. Same reasoning as above: the
# build is the whole application, regenerated by `npm run guard:invite`.
dist-invite-e2e/
artifacts/playwright-invite-output/
test-results/

# Raw database dumps. A pg_dump of production describes the entire security
# model and must stay outside the repository — see
# docs/audit/baselines/README.md. The version-controlled counterpart is the
# sanitized inventory produced by scripts/audit/schema-baseline.mjs.
#
# Deliberately narrow: supabase/migrations/*.sql and supabase/tests/*.sql are
# tracked and must stay tracked, so this matches only the repo root, which is
# where `pg_dump -f prod-schema.sql` lands by default.
/*.sql
/*.dump
prod-schema*.sql
staging-schema*.sql
dist-visual/
