-- ============================================================================
-- ROLLBACK for 20261106160300_sec_identity_forging_rpcs.sql
-- ============================================================================
-- *** APPLYING THIS FILE REOPENS THREE CONFIRMED CROSS-ORG WRITES. ***
--
-- Measured on production 2026-11-06, as a user in organization B with no
-- relationship to organization A:
--   * mark_conversation_read      cleared the victim's unread marker (1 row)
--   * get_or_create_private_view  created a trade_lab_views row in org A's lab
--                                 OWNED BY the victim (1 row)
--   * get_or_create_trade_lab     created a trade_labs row on org A's
--                                 portfolio, having read that portfolio's name
--
-- It also restores ensure_pilot_decision_request_for_user trusting p_user_id,
-- and ensure_default_scenarios with no caller check and no asset check.
--
-- Bodies are verbatim as they stood before the change, including the fact that
-- only ensure_pilot_decision_request_for_user had a pinned search_path. The
-- other four are restored WITHOUT one, which is itself the original state and
-- is itself a weakness.
--
-- The `anon` REVOKE on ensure_default_scenarios is NOT undone: anon held no
-- EXECUTE before the change (measured: 42501), so re-granting it would widen
-- access past the original state rather than restore it.
--
-- No frontend revert is required. All five keep their original signatures and
-- the call sites were not changed, so this file can be applied on its own.
-- ============================================================================

CREATE OR REPLACE FUNCTION public.mark_conversation_read(p_conversation_id uuid, p_user_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
BEGIN
  UPDATE conversation_participants
  SET last_read_at = NOW()
  WHERE conversation_id = p_conversation_id
    AND user_id = p_user_id;
END;
$function$;

CREATE OR REPLACE FUNCTION public.get_or_create_private_view(p_lab_id uuid, p_user_id uuid)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE v_view_id uuid;
BEGIN
  SELECT id INTO v_view_id FROM trade_lab_views
  WHERE lab_id = p_lab_id AND owner_id = p_user_id AND view_type = 'private' AND deleted_at IS NULL LIMIT 1;

  IF v_view_id IS NULL THEN
    INSERT INTO trade_lab_views (lab_id, owner_id, view_type, name, created_by)
    VALUES (p_lab_id, p_user_id, 'private', 'My Workspace', p_user_id)
    RETURNING id INTO v_view_id;
  END IF;
  RETURN v_view_id;
END;
$function$;

CREATE OR REPLACE FUNCTION public.get_or_create_trade_lab(p_portfolio_id uuid)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
    v_lab_id UUID;
    v_portfolio_name TEXT;
BEGIN
    SELECT id INTO v_lab_id
    FROM trade_labs
    WHERE portfolio_id = p_portfolio_id;

    IF v_lab_id IS NOT NULL THEN
        RETURN v_lab_id;
    END IF;

    SELECT name INTO v_portfolio_name
    FROM portfolios
    WHERE id = p_portfolio_id;

    INSERT INTO trade_labs (portfolio_id, name, created_by)
    VALUES (
        p_portfolio_id,
        COALESCE(v_portfolio_name || ' Trade Lab', 'Trade Lab'),
        auth.uid()
    )
    ON CONFLICT (portfolio_id) DO UPDATE SET updated_at = now()
    RETURNING id INTO v_lab_id;

    RETURN v_lab_id;
END;
$function$;

CREATE OR REPLACE FUNCTION public.ensure_pilot_decision_request_for_user(p_user_id uuid DEFAULT auth.uid())
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'public'
AS $function$
DECLARE
  v_scenario RECORD;
  v_existing_id UUID;
  v_new_id UUID;
  v_action TEXT;
  v_target_weight NUMERIC;
  v_proposal_id UUID;
  v_proposal_sizing JSONB;
  v_baseline_weight NUMERIC;
BEGIN
  IF p_user_id IS NULL THEN RETURN NULL; END IF;

  SELECT ps.*, tqi.action AS tqi_action
    INTO v_scenario
  FROM pilot_scenarios ps
  JOIN trade_queue_items tqi ON tqi.id = ps.trade_queue_item_id
  WHERE ps.user_id = p_user_id
    AND ps.status = 'active'
    AND ps.is_template = FALSE
    AND ps.trade_queue_item_id IS NOT NULL
    AND ps.portfolio_id IS NOT NULL
  ORDER BY ps.created_at DESC
  LIMIT 1;

  IF v_scenario.id IS NULL THEN RETURN NULL; END IF;

  SELECT id INTO v_existing_id
  FROM decision_requests
  WHERE trade_queue_item_id = v_scenario.trade_queue_item_id
    AND portfolio_id = v_scenario.portfolio_id
  ORDER BY created_at DESC
  LIMIT 1;
  IF v_existing_id IS NOT NULL THEN RETURN v_existing_id; END IF;

  SELECT id, sizing_context INTO v_proposal_id, v_proposal_sizing
  FROM trade_proposals
  WHERE trade_queue_item_id = v_scenario.trade_queue_item_id
    AND is_active = TRUE
  ORDER BY created_at DESC
  LIMIT 1;

  v_action := COALESCE(v_scenario.tqi_action::TEXT, 'buy');
  v_target_weight := v_scenario.target_weight_pct;
  v_baseline_weight := COALESCE(
    (v_proposal_sizing->>'current_weight_pct')::NUMERIC,
    0
  );

  INSERT INTO decision_requests (
    trade_queue_item_id, requested_by, portfolio_id, urgency,
    context_note, status, requested_action, sizing_weight, sizing_mode,
    proposal_id, submission_snapshot
  ) VALUES (
    v_scenario.trade_queue_item_id, p_user_id, v_scenario.portfolio_id,
    'medium', COALESCE(v_scenario.why_now, 'Pilot scenario recommendation.'),
    'pending', v_action, v_target_weight, 'weight', v_proposal_id,
    jsonb_build_object(
      'baseline_weight', v_baseline_weight,
      'weight', v_target_weight,
      'sizing_context', v_proposal_sizing,
      'pilot_seed', TRUE
    )
  )
  RETURNING id INTO v_new_id;

  RETURN v_new_id;
END;
$function$;

CREATE OR REPLACE FUNCTION public.ensure_default_scenarios(p_asset_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
  scenario_exists boolean;
BEGIN
  -- Check if default scenarios already exist for this asset
  SELECT EXISTS(
    SELECT 1 FROM scenarios
    WHERE asset_id = p_asset_id AND is_default = true
  ) INTO scenario_exists;

  IF NOT scenario_exists THEN
    -- Create Bull scenario
    INSERT INTO scenarios (asset_id, name, description, color, is_default, created_by)
    VALUES (p_asset_id, 'Bull', 'Optimistic scenario with upside drivers materializing', '#22c55e', true, NULL);

    -- Create Base scenario
    INSERT INTO scenarios (asset_id, name, description, color, is_default, created_by)
    VALUES (p_asset_id, 'Base', 'Most likely scenario given current information', '#3b82f6', true, NULL);

    -- Create Bear scenario
    INSERT INTO scenarios (asset_id, name, description, color, is_default, created_by)
    VALUES (p_asset_id, 'Bear', 'Pessimistic scenario with downside risks materializing', '#ef4444', true, NULL);
  END IF;
END;
$function$;
