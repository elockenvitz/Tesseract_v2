-- ============================================================================
-- ROLLBACK for 20261106160200_sec_automation_rule_rpcs.sql
-- ============================================================================
-- *** APPLYING THIS FILE REOPENS A CONFIRMED CROSS-TENANT PATH. ***
--
-- It restores recompute_workflow_rule_schedules trusting its p_user_id
-- argument, so an attacker who knows a victim's user uuid can rewrite another
-- organization's rule schedules. Measured 2026-11-06: {"status":"success"}
-- with the victim's uuid, "Admin permission required" with the attacker's own.
-- It also restores the missing organization term, i.e. removes it.
--
-- THE TWO EXECUTE REVOKES ARE NOT UNDONE HERE. They were split out into
-- 20261106160400 and have their own .rollback. Rolling back the function body
-- and rolling back the privilege change are independent decisions, and you
-- almost certainly want only the former.
--
-- ORDER MATTERS WHEN ROLLING BACK
--   Roll the FRONTEND back at the same time, or sooner. After this file runs,
--   run_workflow_rule and run_due_workflow_rules are gone, so a deployed
--   frontend that calls them fails with PGRST202 ("function not found in the
--   schema cache"), AND if 20261106160400 is applied the old functions are no
--   longer callable either, so the "Run rule" button has no working route at
--   all. The safe sequence is:
--     1. revert the WorkflowsPage.tsx change and deploy it,
--     2. roll back 20261106160400 only if the reverted frontend needs it,
--     3. then run this file.
--
-- PREFER NOT RUNNING THIS AT ALL. The recompute fix is behaviour-preserving
-- for every legitimate caller (measured 8/8), so there is no known reason to
-- restore the forgeable version.
-- ============================================================================

CREATE OR REPLACE FUNCTION public.recompute_workflow_rule_schedules(p_workflow_id uuid, p_user_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
AS $function$
DECLARE
  v_workflow RECORD;
  v_rule RECORD;
  v_next TIMESTAMPTZ;
  v_updated INT := 0;
  v_unsupported INT := 0;
  v_errors INT := 0;
BEGIN
  -- Load workflow
  SELECT * INTO v_workflow
  FROM workflows
  WHERE id = p_workflow_id;

  IF NOT FOUND THEN
    RETURN jsonb_build_object('status', 'error', 'error', 'Workflow not found');
  END IF;

  -- Permission: creator or admin collaborator
  IF v_workflow.created_by != p_user_id
     AND NOT EXISTS (
       SELECT 1 FROM workflow_collaborations
       WHERE workflow_id = p_workflow_id
         AND user_id = p_user_id
         AND permission = 'admin'
     )
  THEN
    RETURN jsonb_build_object('status', 'error', 'error', 'Admin permission required');
  END IF;

  -- Iterate active time_interval rules for this workflow
  FOR v_rule IN
    SELECT id, condition_type, condition_value
    FROM workflow_automation_rules
    WHERE workflow_id = p_workflow_id
      AND condition_type = 'time_interval'
      AND is_active = true
  LOOP
    BEGIN
      v_next := compute_next_run_at(v_rule.condition_type, v_rule.condition_value, now());

      IF v_next IS NOT NULL THEN
        UPDATE workflow_automation_rules
        SET next_run_at = v_next,
            schedule_error = NULL
        WHERE id = v_rule.id;
        v_updated := v_updated + 1;
      ELSE
        UPDATE workflow_automation_rules
        SET next_run_at = NULL,
            schedule_error = 'Unsupported recurrence pattern'
        WHERE id = v_rule.id;
        v_unsupported := v_unsupported + 1;
      END IF;
    EXCEPTION WHEN OTHERS THEN
      UPDATE workflow_automation_rules
      SET schedule_error = SQLERRM
      WHERE id = v_rule.id;
      v_errors := v_errors + 1;
    END;
  END LOOP;

  RETURN jsonb_build_object(
    'status', 'success',
    'updated', v_updated,
    'unsupported', v_unsupported,
    'errors', v_errors,
    'total', v_updated + v_unsupported + v_errors
  );
END;
$function$;

-- Remove the guarded wrappers.
DROP FUNCTION IF EXISTS public.run_due_workflow_rules();
DROP FUNCTION IF EXISTS public.run_workflow_rule(uuid);
