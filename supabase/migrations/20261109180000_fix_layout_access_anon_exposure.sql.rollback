-- Rollback for 20261109180000_fix_layout_access_anon_exposure.sql
--
-- WARNING: running this RESTORES THE ANONYMOUS READ. The function body and
-- policy predicate below are the verbatim production state captured before
-- the fix applied, on 2026-11-09. They are recorded so the change is provably
-- reversible, not because reverting is advisable.
--
-- The anon grant revokes are deliberately NOT undone -- see the foot of this
-- file.

begin;

-- 1. The original function: no pinned search_path, VOLATILE, bare SELECT INTO,
--    no identity check, and an org-wide branch that never references
--    p_user_id. This is the defect.
create or replace function public.user_has_layout_access(
  p_layout_id uuid,
  p_user_id uuid,
  p_min_permission text default 'view'::text
)
returns boolean
language plpgsql
security definer
as $function$
DECLARE
  v_layout_owner UUID;
  v_has_access BOOLEAN := false;
  v_permission_level INTEGER;
  v_min_level INTEGER;
BEGIN
  -- Map permission to numeric level for comparison
  v_min_level := CASE p_min_permission
    WHEN 'view' THEN 1
    WHEN 'edit' THEN 2
    WHEN 'admin' THEN 3
    ELSE 1
  END;

  -- Check if user is the owner (owners have full access)
  SELECT user_id INTO v_layout_owner
  FROM user_asset_page_layouts
  WHERE id = p_layout_id;

  IF v_layout_owner = p_user_id THEN
    RETURN true;
  END IF;

  -- Check direct user collaboration
  SELECT CASE permission
    WHEN 'view' THEN 1
    WHEN 'edit' THEN 2
    WHEN 'admin' THEN 3
    ELSE 0
  END INTO v_permission_level
  FROM layout_collaborations
  WHERE layout_id = p_layout_id
    AND user_id = p_user_id;

  IF v_permission_level >= v_min_level THEN
    RETURN true;
  END IF;

  -- Check team collaboration
  SELECT MAX(CASE lc.permission
    WHEN 'view' THEN 1
    WHEN 'edit' THEN 2
    WHEN 'admin' THEN 3
    ELSE 0
  END) INTO v_permission_level
  FROM layout_collaborations lc
  JOIN team_memberships tm ON lc.team_id = tm.team_id
  WHERE lc.layout_id = p_layout_id
    AND tm.user_id = p_user_id;

  IF v_permission_level >= v_min_level THEN
    RETURN true;
  END IF;

  -- Check org node collaboration (user must be member of the org node)
  SELECT MAX(CASE lc.permission
    WHEN 'view' THEN 1
    WHEN 'edit' THEN 2
    WHEN 'admin' THEN 3
    ELSE 0
  END) INTO v_permission_level
  FROM layout_collaborations lc
  JOIN org_chart_node_members ocnm ON lc.org_node_id = ocnm.node_id
  WHERE lc.layout_id = p_layout_id
    AND ocnm.user_id = p_user_id;

  IF v_permission_level >= v_min_level THEN
    RETURN true;
  END IF;

  -- Check organization-wide collaboration (user_id, team_id, and org_node_id are all NULL)
  SELECT CASE permission
    WHEN 'view' THEN 1
    WHEN 'edit' THEN 2
    WHEN 'admin' THEN 3
    ELSE 0
  END INTO v_permission_level
  FROM layout_collaborations
  WHERE layout_id = p_layout_id
    AND user_id IS NULL
    AND team_id IS NULL
    AND org_node_id IS NULL;

  IF v_permission_level >= v_min_level THEN
    RETURN true;
  END IF;

  RETURN false;
END;
$function$;

comment on function public.user_has_layout_access(uuid, uuid, text) is null;

-- 2. The original policy: TO PUBLIC, with the unconditional all-NULL disjunct.
drop policy if exists "layout_collab_view_own" on public.layout_collaborations;

create policy "layout_collab_view_own"
  on public.layout_collaborations
  for select
  using (
    (user_id = auth.uid())
    OR (EXISTS ( SELECT 1
       FROM team_memberships
      WHERE ((team_memberships.team_id = layout_collaborations.team_id)
        AND (team_memberships.user_id = auth.uid()))))
    OR (EXISTS ( SELECT 1
       FROM org_chart_node_members
      WHERE ((org_chart_node_members.node_id = layout_collaborations.org_node_id)
        AND (org_chart_node_members.user_id = auth.uid()))))
    OR ((user_id IS NULL) AND (team_id IS NULL) AND (org_node_id IS NULL))
  );

-- 3. authenticated's prior grants. The forward migration reduced these to the
--    four DML verbs; the default-privilege set also included TRUNCATE,
--    REFERENCES, TRIGGER and MAINTAIN.
grant all on public.layout_collaborations to authenticated;
grant all on public.user_asset_page_layouts to authenticated;

commit;

-- NOT RESTORED, on purpose:
--
--   grant all on public.layout_collaborations   to anon;
--   grant all on public.user_asset_page_layouts to anon;
--   grant execute on function public.user_has_layout_access(uuid, uuid, text) to anon;
--
-- These were never intentional -- they are Supabase's ALTER DEFAULT PRIVILEGES
-- grants, which land on every object created in `public`. Nothing in the
-- application authenticates as anon to read a layout, so re-granting them
-- would restore the exposure without restoring any behaviour. Uncomment only
-- if a specific anonymous read path is identified, and say which.
