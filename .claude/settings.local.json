{
  "permissions": {
    "allow": [
      "mcp__supabase__execute_sql",
      "Bash(npx tsc:*)",
      "Bash(powershell:*)",
      "Bash(npm run build:*)",
      "Bash(npx vite build)"
    ]
  },
  "env": {
    "MCP_TIMEOUT": "90000"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "supabase"
  ],
  "outputStyle": "Concise"
}
